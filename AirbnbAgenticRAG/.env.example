# =============================================================================
# .env.example — AirbnbAgenticRAG Configuration Template
# =============================================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# NEVER commit .env to git — it is listed in .gitignore.
# =============================================================================

# ── GCP Project ───────────────────────────────────────────────────────────────
# Your GCP project ID (found in Cloud Console → Project Info)
GCP_PROJECT_ID=your-gcp-project-id

# GCP region for all resources (Cloud Run, Memorystore, Vector Search, etc.)
GCP_REGION=us-central1

# ── Vector Search 2.0 ─────────────────────────────────────────────────────────
# Name of the VS2.0 Collection (created by scripts/01_setup_collection.py)
COLLECTION_ID=airbnb-listings-collection

# ── Cloud Storage ─────────────────────────────────────────────────────────────
# GCS bucket name for raw data + eval reports (must already exist)
GCS_BUCKET_NAME=your-gcs-bucket-name

# Folder inside the bucket where the CSV lives
GCS_INPUT_PREFIX=data/

# Filename of the Airbnb listings CSV (gzipped)
GCS_FILENAME=listings.csv.gz

# ── AI Models ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-005
GEMINI_MODEL=gemini-2.5-flash

# ── Ingestion ─────────────────────────────────────────────────────────────────
BATCH_SIZE=50
MAX_LISTINGS=3000

# ── RAG / Agent ──────────────────────────────────────────────────────────────
TOP_K=10
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.2

# ── Redis Cache ───────────────────────────────────────────────────────────────
# Private IP of Memorystore Redis instance (only reachable from Cloud Run via VPC)
# Leave empty when running locally — cache will be automatically disabled
REDIS_HOST=
REDIS_PORT=6379

# Cache TTLs in seconds
CACHE_RAG_TTL=3600
CACHE_ASK_TTL=1800

# ── API URL ───────────────────────────────────────────────────────────────────
# Used by eval/evaluate.py and the Streamlit UI
# Cloud Run URL is set automatically by run/04_deploy.sh
# For local development: http://localhost:8000
RAG_API_URL=http://localhost:8000
